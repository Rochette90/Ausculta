{
  "name": "medtrain-ecos",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack",
    "start": "next start",
    "test": "node --test tests/*.test.mjs",
    "lint": "eslint . --ignore-pattern .next",
    "typecheck": "tsc --noEmit",
    "content:generate-quizzes": "node scripts/generate-quiz-bank.mjs",
    "verify": "npm run typecheck && npm run lint && npm run test && npm run build",
    "db:push": "npx supabase db push",
    "db:seed": "node --env-file=.env.local scripts/seed-supabase-content.mjs",
    "db:seed:questions": "node --env-file=.env.local scripts/seed-supabase-content.mjs --questions-only"
  },
  "dependencies": {
    "@number-flow/react": "^0.6.2",
    "@radix-ui/react-label": "^2.1.15",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-switch": "^1.3.7",
    "@supabase/ssr": "^0.12.4",
    "@supabase/supabase-js": "^2.112.2",
    "canvas-confetti": "^1.9.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^13.1.0",
    "lucide-react": "^1.31.0",
    "next": "^16.3.0",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "stripe": "^22.4.0",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@eslint/js": "9.39.4",
    "@next/eslint-plugin-next": "^16.3.0",
    "@tailwindcss/postcss": "4.2.1",
    "@types/canvas-confetti": "^1.9.0",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "eslint": "9.39.4",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "16.4.0",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.59.3"
  },
  "type": "module"
}
