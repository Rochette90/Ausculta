# Application
# Origine publique (https://... en production). Sert à metadataBase, aux URLs de
# retour Stripe et, derrière un reverse proxy, à la vérification d'origine des API.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Serveur Node (hébergement Infomaniak, Docker). Lus par `next start` et par
# le serveur standalone ; inutiles sur Vercel. Sur l'hébergement Node.js géré
# d'Infomaniak, PORT est fourni par le Manager : ne pas le fixer ici.
# PORT=3000
# HOSTNAME=0.0.0.0
# Domaine servi par Caddy (compose.yaml uniquement).
# APP_DOMAIN=

# Supabase (Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Never prefix this key with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Stripe (server-only except the app URL above)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRO_PRICE_ID=

# Optional AI patient. Server-only keys: never prefix with NEXT_PUBLIC_.
# Providers with a key are tried in this order, then the local scenario engine:
# 1. Anthropic. Model default: claude-haiku-5-5.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
# 2. OpenRouter (backup). Model default: anthropic/claude-haiku-5.5.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
# 3. Groq.
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3-32b
# Optional: "anthropic", "openrouter" or "groq" to try that provider first.
PATIENT_AI_PROVIDER=

# Optional realistic patient voice (ElevenLabs). Server-only: never prefix with NEXT_PUBLIC_.
# Without a key and at least the two voices below, the browser voice is used.
ELEVENLABS_API_KEY=
# Voice IDs from your ElevenLabs account (Voices > copy voice ID).
ELEVENLABS_VOICE_FEMALE=
ELEVENLABS_VOICE_MALE=
# Optional: voices for patients under 35.
ELEVENLABS_VOICE_FEMALE_YOUNG=
ELEVENLABS_VOICE_MALE_YOUNG=
# Optional. Default: eleven_flash_v2_5 (fast, cheapest). eleven_v4_turbo is more expressive.
ELEVENLABS_MODEL=

# Optional cost guards for ECOS stations, per account and per day. Defaults shown.
# The pricing page displays these same values: they define the two offers.
# Discovery (free) plan.
ECOS_DAILY_SESSIONS=3
ECOS_DAILY_MESSAGES=120
# Replies spoken by the realistic voice; the browser voice takes over beyond.
ECOS_DAILY_VOICE_REPLIES=10
# Premium plan (profiles.plan = "pro", set by the Stripe webhook).
ECOS_PRO_DAILY_SESSIONS=10
ECOS_PRO_DAILY_MESSAGES=600
ECOS_PRO_DAILY_VOICE_REPLIES=150
# Messages stored in a single station, both plans.
ECOS_SESSION_MESSAGES=200
# Global cost caps, all accounts combined, per day. Beyond them the station keeps
# working: the local engine answers and the browser voice reads the replies.
# Set them from the provider budgets (ElevenLabs bills per character, ~200 per reply).
ECOS_GLOBAL_DAILY_MESSAGES=3000
ECOS_GLOBAL_DAILY_VOICE_REPLIES=200

# Google sign-in for the LOCAL Supabase stack only (supabase/config.toml reads them with env()).
# The remote project keeps its own values in the dashboard (Authentication > Providers).
SUPABASE_AUTH_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_GOOGLE_SECRET=
